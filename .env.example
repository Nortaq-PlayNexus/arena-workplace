# Copy to .env and fill in. Never commit real secrets.
WORKPLACE_DATA_DIR=./data
WORKPLACE_TOKEN=
WORKER_COUNT=4
WORKER_POLL_INTERVAL=0.5
LEASE_SECONDS=30
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=mock-small
# Real providers (keys read ONLY from environment, never stored in DB):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Autonomy policy: supervised | autonomous
AUTONOMY_MODE=supervised
